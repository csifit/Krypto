# Privy browser configuration
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy server secret. Never expose this with NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# Runtime payment environment:
# testnet = Celo Sepolia + development USDTd
# mainnet = Celo Mainnet + real Tether USDT
#
# Keep local development/test deployments on testnet.
# Set the Vercel Production environment to mainnet when going live.
NEXT_PUBLIC_KRYPTO_NETWORK=testnet

# Supabase server-only configuration.
SUPABASE_URL=https://yueskxkbwlanxcqntpsi.supabase.co
SUPABASE_SECRET_KEY=

# Optional server-side Celo Sepolia RPC configuration.
# The primary defaults to Celo Forno if omitted.
CELO_SEPOLIA_RPC_PRIMARY=https://forno.celo-sepolia.celo-testnet.org
CELO_SEPOLIA_RPC_SECONDARY=

# Optional server-side Celo Mainnet RPC configuration.
# The primary defaults to Celo Forno if omitted.
# Configure an independent professional secondary endpoint for production failover.
CELO_MAINNET_RPC_PRIMARY=https://forno.celo.org
CELO_MAINNET_RPC_SECONDARY=
